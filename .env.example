# AgentCore Auto-Debugger Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!

# Source Code Repository (Optional)
# If your agent code is already in a Git repo, specify it here.
# The auto-fixer clones this repo (read-only) to fetch the code to fix.
# If empty, the auto-fixer pulls code from ECR (or S3 for code-based agents) instead.
GIT_SOURCE_REPO=  # e.g., https://your-git-host/your-username/my-agent-repo.git
GIT_SOURCE_BRANCH=main  # Branch with stable code (default: main)

# AWS Configuration
AWS_REGION=us-east-1
# BEDROCK_MODEL_ID is optional - defaults to Claude Sonnet 4.5 in config.py

# Logging
LOG_LEVEL=INFO

# ── Authentication (Cognito) ──────────────────────────────────────────
# Set AUTH_ENABLED=true for production deployments
AUTH_ENABLED=false
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=your-cognito-app-client-id
COGNITO_REGION=us-east-1

# ── DynamoDB ──────────────────────────────────────────────────────────
# Table name is set automatically by CDK in production
DYNAMODB_TABLE_NAME=AgentCoreDebuggerStack-state
